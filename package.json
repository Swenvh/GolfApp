{
  "name": "golfapp",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "mobile": "pnpm --filter @golfapp/mobile start",
    "admin": "pnpm --filter @golfapp/admin dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:admin": "pnpm --filter @golfapp/admin build",
    "demo": "bash scripts/demo.sh start",
    "demo:reset": "bash scripts/demo.sh reset",
    "demo:stop": "bash scripts/demo.sh stop"
  }
}
